/* assets/style.qss - Thème Sombre Professionnel inspiré de Cubase Pro */

* {
    font-family: "Segoe UI", "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 12px;
    color: #e2e8f0;
}

QMainWindow, QDialog {
    background-color: #121316;
}

QWidget {
    background-color: transparent;
}

/* Barre de Menus */
QMenuBar {
    background-color: #18191f;
    border-bottom: 1px solid #282a36;
    padding: 2px 6px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #2a2d3d;
    color: #38bdf8;
}

QMenu {
    background-color: #1a1c24;
    border: 1px solid #323644;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #0284c7;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #2b2e3b;
    margin: 4px 6px;
}

/* Boutons Généraux */
QPushButton {
    background-color: #222530;
    color: #f1f5f9;
    border: 1px solid #333849;
    border-radius: 5px;
    padding: 5px 12px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #2b2f3e;
    border-color: #475066;
}

QPushButton:pressed {
    background-color: #1a1c25;
}

QPushButton:checked {
    background-color: #0369a1;
    border-color: #38bdf8;
    color: #ffffff;
}

/* Boutons de Navigation (Début, Fin, Reculer, Avancer) */
QPushButton#btn_nav {
    background-color: #1e202b;
    border: 1px solid #2f3344;
    border-radius: 4px;
    color: #94a3b8;
    font-size: 11px;
    padding: 2px;
}

QPushButton#btn_nav:hover {
    background-color: #2b2f42;
    border-color: #38bdf8;
    color: #ffffff;
}

QPushButton#btn_nav:pressed {
    background-color: #161822;
    color: #38bdf8;
}

/* Boutons de Transport Spécifiques */
QPushButton#btn_play {
    background-color: #064e3b;
    border: 1px solid #059669;
    color: #34d399;
    font-size: 14px;
    border-radius: 5px;
    font-weight: bold;
}

QPushButton#btn_play:hover {
    background-color: #059669;
    color: #ffffff;
    border-color: #34d399;
}

QPushButton#btn_play:checked {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.8, fx:0.5, fy:0.5, stop:0 #10b981, stop:0.75 #059669, stop:1 #047857);
    color: #ffffff;
    border: 2px solid #6ee7b7;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#btn_stop {
    background-color: #1e222d;
    border: 1px solid #333849;
    color: #cbd5e1;
    font-size: 13px;
    border-radius: 5px;
}

QPushButton#btn_stop:hover {
    background-color: #333849;
    color: #ffffff;
    border-color: #64748b;
}

QPushButton#btn_record {
    background-color: #3b0d0c;
    border: 1px solid #7f1d1d;
    color: #f87171;
    font-size: 14px;
    border-radius: 5px;
}

QPushButton#btn_record:hover {
    background-color: #b91c1c;
    color: #ffffff;
    border-color: #f87171;
}

QPushButton#btn_record:checked {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.8, fx:0.5, fy:0.5, stop:0 #ff3355, stop:0.75 #dc2626, stop:1 #991b1b);
    color: #ffffff;
    border: 2px solid #fca5a5;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#btn_loop {
    background-color: #271f16;
    border: 1px solid #78350f;
    color: #d97706;
    font-size: 11px;
    border-radius: 5px;
    font-weight: bold;
}

QPushButton#btn_loop:hover {
    background-color: #451a03;
    border-color: #d97706;
    color: #fbbf24;
}

QPushButton#btn_loop:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f59e0b, stop:1 #b45309);
    border: 2px solid #fde68a;
    color: #ffffff;
    font-weight: bold;
}

QPushButton#btn_add_track {
    background-color: #0c4a6e;
    border: 1px solid #0284c7;
    color: #38bdf8;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#btn_add_track:hover {
    background-color: #0284c7;
    color: #ffffff;
}

/* Bouton Flèche Minimiser/Agrandir Zone Inférieure */
QPushButton#btn_toggle_lower {
    background-color: #1f222e;
    border: 1px solid #323646;
    border-radius: 4px;
    color: #38bdf8;
    font-size: 12px;
    font-weight: bold;
    padding: 2px 8px;
    margin-right: 6px;
    margin-top: 2px;
}

QPushButton#btn_toggle_lower:hover {
    background-color: #0284c7;
    color: #ffffff;
    border-color: #38bdf8;
}

/* Affichage Digital (BPM, Mesure / Temps) */
QLabel#digital_display {
    background-color: #0a0b10;
    border: 1px solid #222533;
    border-radius: 4px;
    padding: 3px 8px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    font-weight: bold;
    color: #38bdf8;
}

QLabel#digital_time {
    background-color: #0a0b10;
    border: 1px solid #222533;
    border-radius: 4px;
    padding: 3px 8px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    font-weight: bold;
    color: #34d399;
}

/* SpinBox / BPM */
QDoubleSpinBox, QSpinBox {
    background-color: #161820;
    border: 1px solid #333849;
    border-radius: 4px;
    padding: 3px 6px;
    color: #f1f5f9;
    font-family: "Consolas", monospace;
    font-weight: bold;
}

QDoubleSpinBox:focus, QSpinBox:focus {
    border-color: #38bdf8;
}

/* Sliders / Faders de Volume */
QSlider::groove:horizontal {
    height: 5px;
    background: #1e222e;
    border: 1px solid #2d3345;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #0284c7;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #94a3b8;
    border: 1px solid #cbd5e1;
    width: 12px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 3px;
}

QSlider::handle:horizontal:hover {
    background: #38bdf8;
    border-color: #ffffff;
}

/* Splitters */
QSplitter::handle {
    background-color: #212430;
}

QSplitter::handle:hover {
    background-color: #38bdf8;
}

/* ScrollBars */
QScrollBar:vertical {
    background: #14151b;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #2c303f;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #475069;
}

QScrollBar::horizontal {
    background: #14151b;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #2c303f;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #475069;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}

/* En-tête de Piste */
QFrame.track_header {
    background-color: #1a1c24;
    border-bottom: 1px solid #252834;
    border-right: 2px solid #2d3140;
}

QFrame.track_header:hover {
    background-color: #20232e;
}

/* Boutons Mute, Solo, Rec (Pistes et Inspecteur) */
QPushButton#btn_track_mute, QPushButton.btn_mute, QPushButton[class="btn_mute"] {
    background-color: #1e202b;
    border: 1px solid #33384a;
    border-radius: 4px;
    font-weight: bold;
    font-size: 10px;
    color: #94a3b8;
    max-width: 26px;
    min-width: 20px;
    max-height: 24px;
    min-height: 20px;
    padding: 0px;
}

QPushButton#btn_track_mute:hover, QPushButton.btn_mute:hover, QPushButton[class="btn_mute"]:hover {
    background-color: #2e261a;
    border-color: #f59e0b;
    color: #fbbf24;
}

QPushButton#btn_track_mute:checked, QPushButton.btn_mute:checked, QPushButton[class="btn_mute"]:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f59e0b, stop:1 #b45309);
    color: #ffffff;
    border: 2px solid #fde047;
    font-size: 11px;
    font-weight: 800;
}

QPushButton#btn_track_solo, QPushButton.btn_solo, QPushButton[class="btn_solo"] {
    background-color: #1e202b;
    border: 1px solid #33384a;
    border-radius: 4px;
    font-weight: bold;
    font-size: 10px;
    color: #94a3b8;
    max-width: 26px;
    min-width: 20px;
    max-height: 24px;
    min-height: 20px;
    padding: 0px;
}

QPushButton#btn_track_solo:hover, QPushButton.btn_solo:hover, QPushButton[class="btn_solo"]:hover {
    background-color: #2b2812;
    border-color: #facc15;
    color: #fef08a;
}

QPushButton#btn_track_solo:checked, QPushButton.btn_solo:checked, QPushButton[class="btn_solo"]:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #facc15, stop:1 #ca8a04);
    color: #000000;
    border: 2px solid #fef08a;
    font-size: 11px;
    font-weight: 800;
}

QPushButton#btn_track_rec, QPushButton.btn_rec, QPushButton[class="btn_rec"] {
    background-color: #1e202b;
    border: 1px solid #33384a;
    border-radius: 4px;
    font-weight: bold;
    font-size: 10px;
    color: #94a3b8;
    max-width: 26px;
    min-width: 20px;
    max-height: 24px;
    min-height: 20px;
    padding: 0px;
}

QPushButton#btn_track_rec:hover, QPushButton.btn_rec:hover, QPushButton[class="btn_rec"]:hover {
    background-color: #331518;
    border-color: #ff4d6d;
    color: #ff99aa;
}

QPushButton#btn_track_rec:checked, QPushButton.btn_rec:checked, QPushButton[class="btn_rec"]:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ff3355, stop:1 #dc2626);
    color: #ffffff;
    border: 2px solid #ff7b92;
    font-size: 11px;
    font-weight: 800;
}

/* Panneaux rétractables (Lower Zone) */
QTabWidget::pane {
    border-top: 1px solid #282a36;
    background: #14151b;
}

QTabBar::tab {
    background: #161822;
    border: 1px solid #282a36;
    border-bottom: none;
    padding: 6px 16px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    color: #94a3b8;
    font-weight: 600;
}

QTabBar::tab:selected {
    background: #252834;
    color: #38bdf8;
    border-bottom: 2px solid #38bdf8;
}

QTabBar::tab:hover:!selected {
    background: #1e202b;
    color: #cbd5e1;
}

/* Champs de texte */
QLineEdit {
    background-color: #1a1c24;
    border: 1px solid #323644;
    border-radius: 4px;
    padding: 4px 8px;
    color: #f1f5f9;
}

QLineEdit:focus {
    border-color: #38bdf8;
}

/* Splitters redimensionnables */
QSplitter::handle {
    background-color: #1a1c25;
}

QSplitter::handle:hover {
    background-color: #38bdf8;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

/* Overrides de padding pour petits boutons d'action */
QPushButton#btn_close_sub, QPushButton#btn_del, QPushButton#btn_delete_track {
    padding: 0px;
}
