/* assets/style.qss - Thème Sombre Professionnel inspiré de Cubase Pro */

* {
    font-family: "Segoe UI", "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 12px;
    color: #e2e8f0;
}

QMainWindow, QDialog {
    background-color: #121316;
}

QWidget {
    background-color: transparent;
}

/* Barre de Menus */
QMenuBar {
    background-color: #18191f;
    border-bottom: 1px solid #282a36;
    padding: 2px 6px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #2a2d3d;
    color: #38bdf8;
}

QMenu {
    background-color: #1a1c24;
    border: 1px solid #323644;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #0284c7;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #2b2e3b;
    margin: 4px 6px;
}

/* Boutons Généraux */
QPushButton {
    background-color: #222530;
    color: #f1f5f9;
    border: 1px solid #333849;
    border-radius: 5px;
    padding: 5px 12px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #2b2f3e;
    border-color: #475066;
}

QPushButton:pressed {
    background-color: #1a1c25;
}

QPushButton:checked {
    background-color: #0369a1;
    border-color: #38bdf8;
    color: #ffffff;
}

/* Boutons de Navigation (Début, Fin, Reculer, Avancer) */
QPushButton#btn_nav {
    background-color: #1e202b;
    border: 1px solid #2f3344;
    border-radius: 4px;
    color: #94a3b8;
    font-size: 11px;
    padding: 2px;
}

QPushButton#btn_nav:hover {
    background-color: #2b2f42;
    border-color: #38bdf8;
    color: #ffffff;
}

QPushButton#btn_nav:pressed {
    background-color: #161822;
    color: #38bdf8;
}

/* Boutons de Transport Spécifiques */
QPushButton#btn_play {
    background-color: #064e3b;
    border: 1px solid #059669;
    color: #34d399;
    font-size: 14px;
    border-radius: 5px;
}

QPushButton#btn_play:hover {
    background-color: #059669;
    color: #ffffff;
}

QPushButton#btn_play:checked {
    background-color: #10b981;
    color: #000000;
    border-color: #34d399;
}

QPushButton#btn_stop {
    background-color: #1e222d;
    border: 1px solid #333849;
    color: #cbd5e1;
    font-size: 13px;
    border-radius: 5px;
}

QPushButton#btn_stop:hover {
    background-color: #333849;
    color: #ffffff;
}

QPushButton#btn_record {
    background-color: #450a0a;
    border: 1px solid #dc2626;
    color: #f87171;
    border-radius: 5px;
}

QPushButton#btn_record:hover {
    background-color: #dc2626;
    color: #ffffff;
}

QPushButton#btn_record:checked {
    background-color: #ef4444;
    color: #ffffff;
}

QPushButton#btn_loop {
    background-color: #271f16;
    border: 1px solid #78350f;
    color: #d97706;
    font-size: 11px;
    border-radius: 5px;
}

QPushButton#btn_loop:hover {
    background-color: #451a03;
    border-color: #d97706;
    color: #fbbf24;
}

QPushButton#btn_loop:checked {
    background-color: #d97706;
    border-color: #fbbf24;
    color: #ffffff;
    font-weight: bold;
}

QPushButton#btn_add_track {
    background-color: #0c4a6e;
    border: 1px solid #0284c7;
    color: #38bdf8;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#btn_add_track:hover {
    background-color: #0284c7;
    color: #ffffff;
}

/* Bouton Flèche Minimiser/Agrandir Zone Inférieure */
QPushButton#btn_toggle_lower {
    background-color: #1f222e;
    border: 1px solid #323646;
    border-radius: 4px;
    color: #38bdf8;
    font-size: 12px;
    font-weight: bold;
    padding: 2px 8px;
    margin-right: 6px;
    margin-top: 2px;
}

QPushButton#btn_toggle_lower:hover {
    background-color: #0284c7;
    color: #ffffff;
    border-color: #38bdf8;
}

/* Affichage Digital (BPM, Mesure / Temps) */
QLabel#digital_display {
    background-color: #0a0b10;
    border: 1px solid #222533;
    border-radius: 4px;
    padding: 3px 8px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    font-weight: bold;
    color: #38bdf8;
}

QLabel#digital_time {
    background-color: #0a0b10;
    border: 1px solid #222533;
    border-radius: 4px;
    padding: 3px 8px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    font-weight: bold;
    color: #34d399;
}

/* SpinBox / BPM */
QDoubleSpinBox, QSpinBox {
    background-color: #161820;
    border: 1px solid #333849;
    border-radius: 4px;
    padding: 3px 6px;
    color: #f1f5f9;
    font-family: "Consolas", monospace;
    font-weight: bold;
}

QDoubleSpinBox:focus, QSpinBox:focus {
    border-color: #38bdf8;
}

/* Sliders / Faders de Volume */
QSlider::groove:horizontal {
    height: 5px;
    background: #1e222e;
    border: 1px solid #2d3345;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #0284c7;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #94a3b8;
    border: 1px solid #cbd5e1;
    width: 12px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 3px;
}

QSlider::handle:horizontal:hover {
    background: #38bdf8;
    border-color: #ffffff;
}

/* Splitters */
QSplitter::handle {
    background-color: #212430;
}

QSplitter::handle:hover {
    background-color: #38bdf8;
}

/* ScrollBars */
QScrollBar:vertical {
    background: #14151b;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #2c303f;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #475069;
}

QScrollBar::horizontal {
    background: #14151b;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #2c303f;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #475069;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}

/* En-tête de Piste */
QFrame.track_header {
    background-color: #1a1c24;
    border-bottom: 1px solid #252834;
    border-right: 2px solid #2d3140;
}

QFrame.track_header:hover {
    background-color: #20232e;
}

/* Boutons Mute, Solo, Rec */
QPushButton.btn_mute {
    background-color: #20232f;
    border: 1px solid #33384a;
    border-radius: 3px;
    font-weight: bold;
    font-size: 10px;
    color: #94a3b8;
    max-width: 22px;
    min-width: 22px;
    max-height: 20px;
    min-height: 20px;
    padding: 0px;
}

QPushButton.btn_mute:checked {
    background-color: #d97706;
    color: #ffffff;
    border-color: #f59e0b;
}

QPushButton.btn_solo {
    background-color: #20232f;
    border: 1px solid #33384a;
    border-radius: 3px;
    font-weight: bold;
    font-size: 10px;
    color: #94a3b8;
    max-width: 22px;
    min-width: 22px;
    max-height: 20px;
    min-height: 20px;
    padding: 0px;
}

QPushButton.btn_solo:checked {
    background-color: #eab308;
    color: #1e293b;
    border-color: #facc15;
}

QPushButton.btn_rec {
    background-color: #20232f;
    border: 1px solid #33384a;
    border-radius: 3px;
    font-weight: bold;
    font-size: 10px;
    color: #94a3b8;
    max-width: 22px;
    min-width: 22px;
    max-height: 20px;
    min-height: 20px;
    padding: 0px;
}

QPushButton.btn_rec:checked {
    background-color: #dc2626;
    color: #ffffff;
    border-color: #ef4444;
}

/* Panneaux rétractables (Lower Zone) */
QTabWidget::pane {
    border-top: 1px solid #282a36;
    background: #14151b;
}

QTabBar::tab {
    background: #161822;
    border: 1px solid #282a36;
    border-bottom: none;
    padding: 6px 16px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    color: #94a3b8;
    font-weight: 600;
}

QTabBar::tab:selected {
    background: #252834;
    color: #38bdf8;
    border-bottom: 2px solid #38bdf8;
}

QTabBar::tab:hover:!selected {
    background: #1e202b;
    color: #cbd5e1;
}

/* Champs de texte */
QLineEdit {
    background-color: #1a1c24;
    border: 1px solid #323644;
    border-radius: 4px;
    padding: 4px 8px;
    color: #f1f5f9;
}

QLineEdit:focus {
    border-color: #38bdf8;
}
